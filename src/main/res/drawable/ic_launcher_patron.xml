<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#080808"/>
        </shape>
    </item>
    <item android:gravity="center">
        <shape android:shape="oval">
            <size android:width="88dp" android:height="72dp"/>
            <gradient android:startColor="#FF5262" android:centerColor="#D7192D" android:endColor="#780D20" android:angle="0"/>
            <stroke android:width="1.5dp" android:color="#FFFFAAB2"/>
        </shape>
    </item>
    <item android:gravity="center">
        <shape android:shape="rectangle">
            <size android:width="27dp" android:height="33dp"/>
            <corners android:radius="5dp"/>
            <solid android:color="#FFF5F5"/>
            <stroke android:width="1dp" android:color="#FF780D20"/>
        </shape>
    </item>
    <item android:gravity="center">
        <shape android:shape="rectangle">
            <size android:width="13dp" android:height="17dp"/>
            <corners android:radius="2dp"/>
            <solid android:color="#D7192D"/>
        </shape>
    </item>
</layer-list>